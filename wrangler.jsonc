{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frilregistry-directory",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "registry.frillab.com",
      "custom_domain": true
    }
  ]
}
